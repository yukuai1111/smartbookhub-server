# 服务端口
PORT=3000

# AI模型配置 - 智谱
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=your_zhipu_model_name

# JWT鉴权配置
TokenKey=your_jwt_secret_key
TokenExpire=your_token_expire_time

# MySQL数据库配置
SQL_HOST=your_mysql_host_ip
SQL_USERNAME=your_mysql_username
SQL_PASSWORD=your_mysql_password
SQL_DATABASE=your_mysql_database_name
